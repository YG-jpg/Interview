# Настройки за Docker Compose. Не слагай истински пароли в този файл - той е в git.
# Направи си собствен .env (не е в git) със случайни пароли:
#     python scripts/make_secrets.py
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
DB_HOST=db
DB_NAME=events
DB_USER=events
DB_PASSWORD=
REDIS_URL=redis://redis:6379/0
WEBSOCKET_PORT=8001
SECRET_KEY=
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=
